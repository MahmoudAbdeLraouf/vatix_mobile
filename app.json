{
  "expo": {
    "name": "Vatix",
    "slug": "vatix_mobile",
    "version": "1.0.0",
    "scheme": "vatix",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vatix.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.vatix.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#1A2540",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-navy.png",
          "imageWidth": 1,
          "resizeMode": "contain",
          "backgroundColor": "#1A2540"
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#F5B800"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1821eea1-16a1-482e-8cbf-2156a10616a4"
      }
    },
    "owner": "ekraouf"
  }
}
