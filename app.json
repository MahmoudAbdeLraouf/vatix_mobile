{
  "expo": {
    "name": "Vatix",
    "slug": "vatix_mobile",
    "version": "1.3.1",
    "scheme": "vatix",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vatix.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Vatix needs access to your photo library so you can select images of your products (for example, a phone or laptop you want to sell) to upload when creating a listing or updating your store profile.",
        "NSCameraUsageDescription": "Vatix needs access to your camera so you can take photos of the products you want to list on the marketplace, or a screenshot of a payment receipt to submit for verification."
      }
    },
    "android": {
      "package": "com.vatix.app",
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.vatix.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#1A2540",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-navy.png",
          "imageWidth": 1,
          "resizeMode": "contain",
          "backgroundColor": "#1A2540"
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#F5B800"
        }
      ],
      [
        "@sentry/react-native",
        {
          "url": "https://sentry.io/",
          "organization": "vatix",
          "project": "vatix-mobile"
        }
      ],
      "react-native-iap"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1821eea1-16a1-482e-8cbf-2156a10616a4"
      }
    },
    "owner": "ekraouf",
    "runtimeVersion": "1",
    "updates": {
      "url": "https://u.expo.dev/1821eea1-16a1-482e-8cbf-2156a10616a4"
    }
  }
}
