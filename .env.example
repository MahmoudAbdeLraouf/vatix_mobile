# Backend API + storage
EXPO_PUBLIC_API_URL=http://localhost:3005
EXPO_PUBLIC_MINIO_URL=http://localhost:9000

# Sentry (leave DSN blank to disable init)
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENV=
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Required only for EAS builds to upload source maps to Sentry
SENTRY_AUTH_TOKEN=
